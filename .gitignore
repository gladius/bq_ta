# Generated by a run - reproducible from the source, and large.
# Note: patterns take the whole line. A trailing "# comment" becomes part of the
# pattern and silently fails to match, which is how registry.sqlite got staged once.
profiler/out/
profiler/audit/
profiler/registry.sqlite
profiler/.cache_llm/
*.duckdb

# Generated corpora. The GENERATORS are committed; their output is not -
# samples/hard_corpus.py and samples/extreme_corpus.py rebuild these in seconds.
profiler/samples/*.csv
profiler/samples/*.truth.json

# Secrets. profiler/config.py reads LLM_KEY from .env - never commit it.
.env
*.env
!.env.example

# The throwaway that preceded profiler/: 1.2 GB of DuckDB fixtures and replay data.
# Its conclusions live in profiler/ARCHITECTURE.md and profiler/STRESS_FINDINGS.md.
spike/

# Tooling
__pycache__/
*.py[cod]
.pytest_cache/
.deepeval/
.claude/
.venv/
venv/
.DS_Store
